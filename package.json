{
  "name": "feedora",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev:web": "pnpm --filter @feedora/web dev",
    "build:web": "pnpm --filter @feedora/web build",
    "dev:desktop-ui": "pnpm --filter @feedora/desktop-ui dev",
    "build:desktop-ui": "pnpm --filter @feedora/desktop-ui build",
    "build:clients": "pnpm --filter @feedora/web build && pnpm --filter @feedora/desktop-ui build"
  }
}
